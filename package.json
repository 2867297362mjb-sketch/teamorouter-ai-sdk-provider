{
  "name": "@teamorouter/ai-sdk-provider",
  "version": "0.1.0",
  "description": "TeamoRouter provider for the Vercel AI SDK: one API key for Claude, GPT, Gemini, DeepSeek, GLM, Kimi and Qwen models.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel-ai-sdk",
    "provider",
    "teamorouter",
    "llm",
    "claude",
    "deepseek"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2867297362mjb-sketch/teamorouter-ai-sdk-provider.git"
  },
  "homepage": "https://github.com/2867297362mjb-sketch/teamorouter-ai-sdk-provider#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.99",
    "@ai-sdk/openai-compatible": "^3.0.87",
    "@ai-sdk/provider": "^4.0.37",
    "@ai-sdk/provider-utils": "^5.0.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ai": "^7.0.166",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
